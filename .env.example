# ── Strategy Toggles ────────────────────────────────────────────────────────
ENABLE_RESOLUTION_CRITERIA=true
ENABLE_BASE_RATES=true
ENABLE_LATENCY_ARB=true

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/polymarket_alpha

# ── Polymarket CLOB (order placement only) ───────────────────────────────────
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ── External Platforms ───────────────────────────────────────────────────────
MANIFOLD_API_KEY=
KALSHI_API_KEY=

# ── Risk Controls ────────────────────────────────────────────────────────────
REQUIRE_HUMAN_CONFIRMATION=true
MAX_POSITION_USD=100.0
KELLY_FRACTION=0.25
HUMAN_CONFIRMATION_THRESHOLD_USD=50.0

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_SECRET_KEY=change-me-in-production
